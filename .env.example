# Copy to .env for local Compose use and replace every change-me value.
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=tomato_db
POSTGRES_USER=tomato_user
POSTGRES_PASSWORD=change-me

RABBITMQ_DEFAULT_USER=tomato_mqtt
RABBITMQ_PASSWORD=change-me
AI_WORKER_INGESTION_TOKEN=change-me
EVIDENCE_IMAGE_UPLOAD_TOKEN=change-me

# Keep 0.0.0.0:1883 reachable when a Raspberry Pi is outside this host.
MQTT_BIND_ADDRESS=0.0.0.0

EMAIL_NOTIFICATIONS_ENABLED=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Smart Eye Alerts <alerts@example.com>
FRONTEND_BASE_URL=http://localhost
ALERT_EMAIL_RECIPIENTS=
REVIEW_EMAIL_RECIPIENTS=
